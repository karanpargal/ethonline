# --- Agent brain (key-swappable) ---
AI_PROVIDER=anthropic            # anthropic | openai
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Privy (treasury lane) ---
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# P-256 authorization key for the agent signer (base64 DER), generated during setup
PRIVY_AGENT_AUTH_KEY=
# Set after running the setup script:
PRIVY_ORG_ID=
PRIVY_TREASURY_WALLET_ID=
PRIVY_TREASURY_ADDRESS=

# --- Circle / Arc (x402 petty-cash lane) ---
# Dedicated low-value EOA. NEVER the treasury key. Capped exposure by design.
PETTY_CASH_PRIVATE_KEY=
CIRCLE_GATEWAY_FACILITATOR=https://gateway-api-testnet.circle.com

# --- Chain (swappable for Arc mainnet after Sept 16) ---
CHAIN=arc-testnet                # arc-testnet | arc-mainnet | base-sepolia (fallback B)
ARC_RPC_URL=https://rpc.testnet.arc.io

# --- x402 demo seller ("MarketFeed Data Inc") ---
SELLER_ADDRESS=
SELLER_PORT=3002
X402_MARKET_URL=http://localhost:3002/api/market-brief

# --- App ---
DATABASE_PATH=./autocfo.db
AGENT_PORT=3001
NEXT_PUBLIC_AGENT_API=http://localhost:3001

# --- Web (Vercel) ---
NEXT_PUBLIC_AGENT_API=http://localhost:3001
NEXT_PUBLIC_PRIVY_APP_ID=
